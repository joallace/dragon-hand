// Menu theme: laid-back, 96 BPM, 8-bar loop.
// Strudel code (https://strudel.cc). One cycle = one bar.
// Chords: Fmaj7 Am7 Dm7 Bbmaj7
setcpm(96 / 4)

// Pad: slow chords.
$: note("<[f3,a3,c4,e4] [a3,c4,e4,g4] [d3,f3,a3,c4] [bb2,d3,f3,a3]>")
  .s("triangle").attack(.25).release(.6).lpf(1500).room(.5).gain(.5)

// Bass: one soft note on the root, a pickup before the next bar.
$: note("<[f2 ~ ~ ~ ~ ~ ~ c2] [a1 ~ ~ ~ ~ ~ ~ e2] [d2 ~ ~ ~ ~ ~ ~ a1] [bb1 ~ ~ ~ ~ ~ ~ c2]>")
  .s("sine").attack(.01).decay(.3).sustain(.7).release(.2).clip(1.6).gain(1.1)

// Arpeggio: chord tones with an echo.
$: note(`<
  [f4 a4 c5 e5 c5 a4 e5 c5]
  [e4 a4 c5 g5 c5 a4 g5 e5]
  [d4 f4 a4 c5 a4 f4 c5 a4]
  [d4 f4 bb4 a4 f4 d5 bb4 f4]
>`).s("square").lpf(sine.range(900, 2200).slow(8)).decay(.14).sustain(0)
  .delay(.4).delaytime(.3125).delayfeedback(.4).pan(sine.range(.3, .7).slow(4)).gain(.38)

// Melody: answers in the second half of the loop.
$: note("<~!4 [a5 ~ g5 e5 ~ ~ c5 ~] [e5 ~ ~ g5 ~ e5 ~ ~] [f5 ~ e5 d5 ~ ~ a4 ~] [d5 ~ ~ f5 ~ a5 ~ ~]>")
  .s("triangle").attack(.02).decay(.3).sustain(.5).release(.35)
  .vib(4.5).vibmod(.15).room(.6).delay(.25).delaytime(.3125).gain(.6)

// Drums: light.
$: s("bd ~ ~ ~ bd ~ ~ ~").gain(.6)
$: s("~ ~ rim ~ ~ ~ rim ~").gain(.35)
$: s("hh*8").gain("[.3 .16]*4")
