class_name CharacterDef
extends Resource
## A playable character: identity, look, moveset and optional stat overrides.
## Saved in data/characters/<id>.tres (generated by tools/generate_moves.gd).

@export var id: StringName = &""
@export var display_name: String = ""
@export var color: Color = Color(0.8, 0.4, 0.2)
## Placeholder body proportions (presentation only): (width, height, depth).
## The sim's hurtbox comes from stat_overrides (body_height, body_radius).
@export var body_scale: Vector3 = Vector3.ONE
## Belly radius (m, before body_scale); 0 = none. Adds the model's unit
## "belly" part (or a sphere on the primitive body); a dedicated model with
## a gut of its own has no belly part, so this only shapes the fallback.
@export var belly_radius: float = 0.0
## Body model (presentation only; tools/blender/build_fighter.py char=<id>);
## empty = the shared Tuning.vfx.fighter_model_path. Same rig and palette
## slots for every model, scaled by body_scale like the default one.
@export var model_path: String = ""
## Every move the character can perform (normals, specials, payloads).
@export var moves: Array[MoveData] = []

@export_group("Move roles")
## LIGHT string in order (BT3 rush: the last step is the ender); chained
## through each move's `cancel_into`, which also lists that position's HEAVY
## finisher (MID) and the HIGH / LOW ones (picked by MoveData.height).
@export var light_string: Array[StringName] = []
## Standalone HEAVY from neutral (mid); forward / back + HEAVY pick the
## high / low variants (fall back to `heavy` when empty). The Brawler's are
## also its mid-string forward / back finishers (upper hook, sweep).
@export var heavy: StringName = &""
@export var heavy_high: StringName = &""
@export var heavy_low: StringName = &""
## HEAVY after the full LIGHT string (the finisher that knocks down).
@export var finisher: StringName = &""
## LIGHT while jumping.
@export var jump_attack: StringName = &""
## HEAVY while jumping within close_combat_range (out of it = ki blast);
## falls back to `jump_attack` when empty.
@export var jump_heavy: StringName = &""
## HEAVY pressed during a duck (forward dodge): God Hand low kick out of the
## crouch; falls back to the stick's HEAVY when empty.
@export var duck_heavy: StringName = &""
## LIGHT while lying after a knockdown: God Hand get-up strike (rises
## attacking); empty = LIGHT is a plain quick rise.
@export var getup_attack: StringName = &""
@export var dash_attack: StringName = &""
@export var ki_blast: StringName = &""
## THROW: grab that beats guard (stick back = throw behind you).
@export var throw: StringName = &""
## Counter guard: forced counter attack after a stick-forward + LIGHT guard
## catches the first hit of a string.
@export var counter: StringName = &""
## Forward + SPECIAL (CHARGE + HEAVY).
@export var super1: StringName = &""
## Neutral SPECIAL (CHARGE + HEAVY).
@export var super2: StringName = &""
## Back + SPECIAL with a full gauge.
@export var ultimate: StringName = &""

@export_group("Stats")
## FighterTuning property name -> value, applied on a per-fighter copy.
@export var stat_overrides: Dictionary = {}


func move(move_id: StringName) -> MoveData:
	for m in moves:
		if m.id == move_id:
			return m
	return null


## Shared tuning, or a private copy with this character's overrides applied.
func build_tuning(base: FighterTuning) -> FighterTuning:
	if stat_overrides.is_empty():
		return base
	var t: FighterTuning = base.duplicate()
	for key: Variant in stat_overrides:
		t.set(StringName(key), stat_overrides[key])
	return t
